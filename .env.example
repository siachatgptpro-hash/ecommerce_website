# Server-only production/runtime variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret
# Admin image uploads are stored in PostgreSQL/Neon; no Blob token is needed.
CRON_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# First-admin bootstrap (used once: npm run admin:bootstrap; password min 14 chars)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Razorpay Test Mode for development/staging; never commit real values
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Optional public key only if a future client-side integration requires it
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me

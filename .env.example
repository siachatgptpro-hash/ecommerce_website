# Server-only production/runtime variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Razorpay Test Mode for development/staging; never commit real values
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Optional public key only if a future client-side integration requires it
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me
